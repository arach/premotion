{
  "name": "premotion",
  "version": "1.0.0",
  "description": "Video editing with Remotion + Hudson-shelled catalog studio",
  "type": "module",
  "scripts": {
    "catalog": "bun run scripts/build-catalog.ts",
    "gen:compositions": "bun scripts/generate-compositions-registry.ts",
    "dev": "bun run catalog && next dev --port 3100",
    "build": "bun run catalog && bun run gen:compositions && next build",
    "start": "next start --port 3100",
    "studio": "bun run gen:compositions && remotion studio",
    "studio:templates": "bun run gen:compositions && remotion studio src/studio.templates.ts",
    "studio:logos": "bun run gen:compositions && remotion studio src/studio.logos.ts",
    "render": "bun run gen:compositions && remotion render",
    "render:full": "bun run gen:compositions && remotion render FullVideo out/video.mp4",
    "quote": "node scripts/make-quote.mjs",
    "analyze": "bun run scripts/analyze-video.ts",
    "postinstall": "rm -rf node_modules/hudsonkit && cp -R ../hudson/packages/hudson-sdk node_modules/hudsonkit"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.0",
    "@anthropic-ai/sdk": "^0.80.0",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@remotion/captions": "^4.0.422",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "4.0.407",
    "@remotion/media": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "ai": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "bunqueue": "^2.7.10",
    "hudsonkit": "file:../hudson/packages/hudson-sdk",
    "lucide-react": "^0.574.0",
    "motion": "^12.0.0",
    "next": "^16.1.6",
    "openai": "^6.34.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
